+_ACCEPT_V1_ENV = "INTER_NODE_ACCEPT_V1"         # 接收端还认不认 v1："1"（缺省）或 "0"
+_SELF_HOST_ENV = "INTER_NODE_SELF_HOST"         # 本节点对外域名（= 对端 PEER_NODE_URL 里的那个）
