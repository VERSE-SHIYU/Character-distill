+-- 102 — group_sessions.member_phases（PG 037 的 SQLite 孪生；列集锁要求两侧相等）
+-- 语义见 PG 037 与 docs/specs/group-arc-phase.md。
+ALTER TABLE group_sessions ADD COLUMN member_phases TEXT NOT NULL DEFAULT '{}';
diff --git a/storage/migrations_pg/037_group_member_phases.sql b/storage/migrations_pg/037_group_member_phases.sql
new file mode 100644
index 0000000..17cd83c
--- /dev/null
+++ b/storage/migrations_pg/037_group_member_phases.sql
@@ -0,0 +1,11 @@
+-- ============================================================
+-- 037 — group_sessions.member_phases：建群时给每个 AI 人物选的时期（JSON：卡 id → 阶段号）
+--
+-- 只存选了且有效的（`valid_phase` 非 None）；没出现的卡 = 最后阶段。只存阶段号，不存投影后的卡
+-- —— 怎么投影只由 `core/arc_view.project_card` 一处算（与一对一 `sessions.arc_phase` 同口径）。
+-- 只在建群时写一次；建群后不能改（要换时期就新建群）。
+--
+-- 幂等：`IF NOT EXISTS`。SQLite 孪生：102（列集锁要求两侧相等）。
+-- ============================================================
+
+ALTER TABLE group_sessions ADD COLUMN IF NOT EXISTS member_phases TEXT NOT NULL DEFAULT '{}';
