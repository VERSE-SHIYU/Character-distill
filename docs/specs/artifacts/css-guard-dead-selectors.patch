diff --git a/web/frontend/scripts/css-guard/deadSelectors.js b/web/frontend/scripts/css-guard/deadSelectors.js
new file mode 100644
index 00000000..404d3ab7
--- /dev/null
+++ b/web/frontend/scripts/css-guard/deadSelectors.js
@@ -0,0 +1,104 @@
+// CSS 死选择器检查：CSS 里引用的类名，在前端源码里已经找不到 → 这条选择器匹配不到任何元素。
+// 纯函数，不读文件；读文件和比对基线在 deadSelectors.test.js。
+//
+// 「用到的类名」= 源码里所有字符串 / 模板字面量中出现的词（模板的 ${...} 里递归再扫一遍）。
+// 模板里紧贴 ${} 的静态片段若以 - 或 _ 结尾（`theme-${x}`），记为动态前缀，以它开头的类都算用到。
+// 一条复合选择器「死」= 它要求的类里有一个没用到（:not/:is/:where/:has(...) 和 [...] 里的类不算要求）。
+
+const STRING_RE = /'(?:\\.|[^'\\\n])*'|"(?:\\.|[^"\\\n])*"|`(?:\\.|[^`\\])*`/gs
+const WORD_RE = /-?[A-Za-z_][\w-]*/g
+const INTERP_RE = /\$\{((?:[^{}]|\{(?:[^{}]|\{[^{}]*\})*\})*)\}/g
+const CLASS_RE = /\.(-?[A-Za-z_][\w-]*)/g
+
+/** 从一份源码文本里收集用到的词和动态前缀，写进 acc（{ words: Set, prefixes: Set }）。 */
+export function collectUsage(text, acc = { words: new Set(), prefixes: new Set() }) {
+  for (const m of text.matchAll(STRING_RE)) {
+    const quote = m[0][0]
+    let body = m[0].slice(1, -1)
+    if (quote === '`') {
+      const inner = [...body.matchAll(INTERP_RE)].map((x) => x[1])
+      const parts = body.split(INTERP_RE).filter((_, i) => i % 2 === 0)
+      parts.forEach((part, i) => {
+        const toks = part.split(/\s+/).filter(Boolean)
+        const glued = i < parts.length - 1 && part && !/\s$/.test(part) && toks.length
+        if (glued && /[-_]$/.test(toks.at(-1)) && toks.at(-1).length >= 2) acc.prefixes.add(toks.at(-1))
+      })
+      inner.forEach((code) => collectUsage(code, acc))
+      body = parts.join(' ')
+    }
+    for (const w of body.matchAll(WORD_RE)) acc.words.add(w[0])
+  }
+  return acc
+}
+
+/** 一份 CSS 文本里的所有普通规则：{ line, selectors: string[] }。@keyframes 里的帧不算。 */
+export function parseRules(css) {
+  const clean = css.replace(/\/\*[\s\S]*?\*\//g, (c) => c.replace(/[^\n]/g, ' '))
+  const lineStarts = [0]
+  for (let i = 0; i < clean.length; i++) if (clean[i] === '\n') lineStarts.push(i + 1)
+  const lineOf = (offset) => {
+    let lo = 0
+    let hi = lineStarts.length - 1
+    while (lo < hi) {
+      const mid = (lo + hi + 1) >> 1
+      if (lineStarts[mid] <= offset) lo = mid
+      else hi = mid - 1
+    }
+    return lo + 1
+  }
+  const rules = []
+  const stack = []
+  let start = 0
+  for (let i = 0; i < clean.length; i++) {
+    const ch = clean[i]
+    if (ch === '{') {
+      const raw = clean.slice(start, i)
+      const prelude = raw.trim()
+      const inKeyframes = stack.some((s) => s.startsWith('@') && s.includes('keyframes'))
+      if (prelude && !prelude.startsWith('@') && !inKeyframes) {
+        const line = lineOf(start + (raw.length - raw.trimStart().length))
+        rules.push({ line, selectors: prelude.split(',').map((s) => s.trim()).filter(Boolean) })
+      }
+      stack.push(prelude)
+      start = i + 1
+    } else if (ch === '}') {
+      stack.pop()
+      start = i + 1
+    } else if (ch === ';') {
+      start = i + 1
+    }
+  }
+  return rules
+}
+
+function stripNonRequired(selector) {
+  let s = selector.replace(/\[[^\]]*\]/g, '')
+  for (;;) {
+    const next = s.replace(/:(not|where|is|has)\((?:[^()]|\([^()]*\))*\)/g, '')
+    if (next === s) return s
+    s = next
+  }
+}
+
+/** 这条选择器要求、但源码里没用到的类。 */
+export function deadClasses(selector, usage, libPrefixes) {
+  const required = [...stripNonRequired(selector).matchAll(CLASS_RE)].map((m) => m[1])
+  return [...new Set(required)].filter((c) =>
+    !usage.words.has(c)
+    && ![...usage.prefixes].some((p) => c.startsWith(p))
+    && !libPrefixes.some((p) => c.startsWith(p)))
+}
+
+/** 所有死选择器：[{ file, line, selector, dead: string[] }]。cssFiles: [{ file, text }]。 */
+export function findDeadSelectors(cssFiles, usage, libPrefixes) {
+  const out = []
+  for (const { file, text } of cssFiles) {
+    for (const rule of parseRules(text)) {
+      for (const selector of rule.selectors) {
+        const dead = deadClasses(selector, usage, libPrefixes)
+        if (dead.length) out.push({ file, line: rule.line, selector: selector.replace(/\s+/g, ' '), dead })
+      }
+    }
+  }
+  return out
+}
diff --git a/web/frontend/scripts/css-guard/deadSelectors.test.js b/web/frontend/scripts/css-guard/deadSelectors.test.js
new file mode 100644
index 00000000..fd2328a0
--- /dev/null
+++ b/web/frontend/scripts/css-guard/deadSelectors.test.js
@@ -0,0 +1,89 @@
+// CSS 死选择器检查（CI 里随 npm test 跑）。
+// 1）扫描器自身的单测；2）全仓扫描结果必须恰好等于基线：多出来的 = 新写出的死样式，少了的 = 基线该删的行。
+import { describe, it, expect } from 'vitest'
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { collectUsage, parseRules, deadClasses, findDeadSelectors } from './deadSelectors.js'
+
+const HERE = path.dirname(fileURLToPath(import.meta.url))
+const FRONTEND = path.resolve(HERE, '../..')
+const BASELINE = path.join(HERE, 'dead-selectors.baseline.json')
+const LIB_PREFIXES = JSON.parse(fs.readFileSync(path.join(HERE, 'allowlist.json'), 'utf8')).libPrefixes.map((x) => x.prefix)
+
+const SKIP_DIRS = new Set(['node_modules', 'dist', '__tests__', 'e2e'])
+function walk(dir) {
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const p = path.join(dir, e.name)
+    if (e.isDirectory()) return SKIP_DIRS.has(e.name) ? [] : walk(p)
+    return [p]
+  })
+}
+
+function scanRepo() {
+  const files = walk(path.join(FRONTEND, 'src')).concat([path.join(FRONTEND, 'index.html')])
+  const usage = { words: new Set(), prefixes: new Set() }
+  for (const f of files) {
+    if (/\.(jsx?|tsx?|mjs|html)$/.test(f) && !/\.(test|spec)\./.test(f)) collectUsage(fs.readFileSync(f, 'utf8'), usage)
+  }
+  const css = files.filter((f) => f.endsWith('.css'))
+    .map((f) => ({ file: path.relative(FRONTEND, f).split(path.sep).join('/'), text: fs.readFileSync(f, 'utf8') }))
+  return findDeadSelectors(css, usage, LIB_PREFIXES)
+}
+
+const key = (d) => `${d.file} :: ${d.selector}`
+function multisetDiff(a, b) {
+  const count = new Map()
+  b.forEach((k) => count.set(k, (count.get(k) || 0) + 1))
+  return a.filter((k) => {
+    const n = count.get(k) || 0
+    if (n === 0) return true
+    count.set(k, n - 1)
+    return false
+  })
+}
+
+describe('扫描器', () => {
+  it('普通字符串和模板 ${} 里的类名都算用到；紧贴 ${} 的前缀算动态前缀', () => {
+    const u = collectUsage("const a = 'foo bar'; const b = `x-row${on ? ' is-on' : ''} theme-${t}`")
+    expect([...u.words]).toEqual(expect.arrayContaining(['foo', 'bar', 'x-row', 'is-on']))
+    expect([...u.prefixes]).toEqual(['theme-'])
+  })
+
+  it(':not(...) 和 [...] 里的类不算要求；库前缀豁免', () => {
+    const u = { words: new Set(['live']), prefixes: new Set(['theme-']) }
+    expect(deadClasses('.live:not(.gone)[data-x=".y"]', u, [])).toEqual([])
+    expect(deadClasses('.theme-dark .live', u, [])).toEqual([])
+    expect(deadClasses('.wrap .adm-tab-bar', { words: new Set(['wrap']), prefixes: new Set() }, ['adm-'])).toEqual([])
+    expect(deadClasses('.gone .live', u, [])).toEqual(['gone'])
+  })
+
+  it('@media 里的规则照算，@keyframes 里的帧不算；行号是选择器所在行', () => {
+    const rules = parseRules('/* c */\n.a { x: 1 }\n@media (max-width: 1px) {\n  .b, .c { y: 2 }\n}\n@keyframes k { from { o: 0 } to { o: 1 } }\n')
+    expect(rules).toEqual([{ line: 2, selectors: ['.a'] }, { line: 4, selectors: ['.b', '.c'] }])
+  })
+})
+
+describe('CSS 死选择器（基线模式）', () => {
+  const found = scanRepo()
+  const baseline = JSON.parse(fs.readFileSync(BASELINE, 'utf8')).entries
+
+  it('没有新写出的死样式', () => {
+    const added = multisetDiff(found.map(key), baseline)
+    const detail = found.filter((d) => added.includes(key(d)))
+      .map((d) => `  ${d.file}:${d.line}  ${d.selector}  （找不到的类：${d.dead.join(' ')}）`)
+    expect(added, [
+      '下面这些样式匹配不到任何元素：选择器里的类名在前端代码里找不到。',
+      '修法：删掉这条样式，或者把类名用回组件里。不要把它加进基线。',
+      ...detail,
+    ].join('\n')).toEqual([])
+  })
+
+  it('基线里没有过期的行（只减不增）', () => {
+    const stale = multisetDiff(baseline, found.map(key))
+    expect(stale, [
+      '这些行已经不是死样式了（已删除或重新用上），请从 scripts/css-guard/dead-selectors.baseline.json 删掉：',
+      ...stale.map((k) => `  ${k}`),
+    ].join('\n')).toEqual([])
+  })
+})
